# Copy this file to .env and fill in your real keys.
# Never commit .env to version control.
#
# You can also skip this file entirely and use the dashboard's Settings
# page instead — it writes .env for you and reloads it live, no editing
# required.

SPORTSDATAIO_API_KEY=your_sportsdataio_key_here
ODDS_API_KEY=your_odds_api_key_here
OPTICODDS_API_KEY=
WEATHER_API_KEY=
PARLAY_API_KEY=
SHARPAPI_KEY=

# Set to "false" once you have real keys and want to hit live APIs.
MLB_EDGE_MOCK_MODE=true

# Leave MLB_EDGE_DB_PATH unset (commented out) — the system automatically
# uses a separate database file for mock mode vs. live mode, so toggling
# MLB_EDGE_MOCK_MODE never mixes synthetic sample games with real ones.
# Only uncomment this if you specifically want to override that and take
# responsibility for keeping mock/live data separate yourself.
# MLB_EDGE_DB_PATH=./mlb_edge_lab.db

ODDS_API_REGIONS=us
ODDS_API_BOOKMAKERS=
